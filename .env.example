# Copy this file to .env and fill in your credentials.
# Values may be unquoted or enclosed in matching single/double quotes.
# Quoted values are literal; no variable expansion or escape processing occurs.
WIFI_SSID="your-wifi-name"
WIFI_PASSWORD="your-wifi-password"
MQTT_USERNAME="your-mqtt-username"
MQTT_PASSWORD="your-mqtt-password"
MQTT_BROKER="your-broker-ip-address"
MQTT_PORT=1883
MQTT_TOPIC="lora/solar/temperature"
